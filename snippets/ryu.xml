<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote   name="RyuUI"
            fetch="https://github.com/RyuUI-Org"
            revision="refs/heads/vic" />

  <remote  name="RyuUI-Gitlab"
           fetch="https://gitlab.com/ryudev-project"
           revision="refs/heads/fifteen" />

  <!-- AOSP additions -->
  <project path="build/make" name="build" groups="pdk, sysui-studio" remote="RyuUI">
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <project path="build/soong" name="build_soong" groups="pdk,tradefed, sysui-studio" remote="RyuUI">
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>
  <project path="bootable/recovery" name="bootable_recovery" groups="pdk" remote="RyuUI" />
  <project path="device/lineage/sepolicy" name="device_ryu_sepolicy" remote="RyuUI" />
  <project path="frameworks/av" name="frameworks_av" groups="pdk" remote="RyuUI" />
  <project path="frameworks/base" name="frameworks_base" groups="pdk-cw-fs,pdk-fs" remote="RyuUI" />
  <project path="frameworks/native" name="frameworks_native" groups="pdk" remote="RyuUI" />
  <project path="packages/apps/RyuLab" name="packages_apps_RyuLab" remote="RyuUI" />
  <project path="packages/apps/Settings" name="packages_apps_Settings" groups="pdk-fs" remote="RyuUI" />
  <project path="packages/apps/Updater" name="packages_apps_Updater" remote="RyuUI" />
  <project path="ryu/ryu_ota" name="ryu_ota" remote="RyuUI" />
  <project path="system/core" name="system_core" groups="pdk" remote="RyuUI" />

  <!-- Vendor additions -->
  <project path="vendor/ryu" name="vendor_ryu" remote="RyuUI" />
  <project path="vendor/ryu-pif" name="vendor_ryu-pif" remote="RyuUI" />
  <project path="vendor/ryu/maintainer" name="ryu_official_maintainer" remote="RyuUI" />

</manifest>